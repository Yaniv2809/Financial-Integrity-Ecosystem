# ============================================
# Financial Integrity Ecosystem — Environment Variables
# Copy this file to .env and fill in your values
# All variables are optional — defaults are in config/config.json
# ============================================

# AI Analysis
GROQ_API_KEY=your_groq_api_key_here

# Database Type (sqlite | mysql)
# DB_TYPE=mysql

# MySQL Connection (override config.json defaults)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=test_user
# MYSQL_PASSWORD=test_password
# MYSQL_DATABASE=expense_test_db

# URLs (override config.json defaults)
# WEB_URL=https://atidcollege.co.il/Xamples/expense-tracker/
# API_URL=http://localhost:3000/expenses
# FLASK_API_URL=http://localhost:5000/expenses
# AI_URL=https://api.groq.com/openai/v1/chat/completions
# CURRENCY_API_URL=https://open.er-api.com/v6/latest/USD

# Browser
# HEADLESS=true

